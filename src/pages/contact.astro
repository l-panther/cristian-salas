---
import Layout from '../layouts/Layout.astro';
import { COMPANY_NAME, COMPANY_EMAIL, COMPANY_TELEPHONE, COMPANY_LOCATION } from '../lib/config';
const formattedPhone =
  COMPANY_TELEPHONE.length > 4
    ? `${COMPANY_TELEPHONE.slice(0, 4)} ${COMPANY_TELEPHONE.slice(4)}`
    : COMPANY_TELEPHONE;
---

<Layout>
  <!-- Contact -->
  <article id="contact">

    <h1>Contact Me</h1>
    <ion-list>

      <!-- Phone Number -->
      <ion-item 
        button 
        href={`tel:${COMPANY_TELEPHONE}`} 
        aria-label={`Call ${COMPANY_NAME}`}
      >
        <ion-label>
          <span id="phone-number">{formattedPhone}</span>
        </ion-label>
        <ion-icon name="call" slot="end" title="Call Me"></ion-icon>
      </ion-item>

      <!-- Email -->
      <ion-item 
        button 
        href="#"
        aria-label={`Send email to ${COMPANY_EMAIL}`}
      >
        <ion-label>
          <span id="email">{COMPANY_EMAIL}</span>
        </ion-label>
        <ion-icon name="mail" slot="end" title="Send email"></ion-icon>
      </ion-item>

      <!-- Location -->
      <ion-item>
        <ion-label>
          <span id="location">{COMPANY_LOCATION}</span>
        </ion-label>
        <ion-icon name="location" slot="end" title="Location"></ion-icon>
      </ion-item>

    </ion-list>
  </article> <!-- End Contact -->
</Layout>
