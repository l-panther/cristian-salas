---
import website from '../lib/Gallery.js';  // Import Website class
const media = website.getGallery(); // Get media data
---

<div class="video-gallery">
  <ion-grid>
    <ion-row>
      {media.map((item) => (
        <ion-col
          size="12"
          size-md="6"
          size-lg="4"
          key={item.id}
          class="media-container"
        >
          <ion-card>
            <div class="video-preview">
              <img
                src={`${import.meta.env.BASE_URL}assets/images/archive/placeholder.webp`}
                alt="Video preview placeholder"
                loading="lazy"
              />

               <span class="play-icon" aria-hidden="true">
                <ion-icon name="play"></ion-icon>
              </span>
            </div>

            <ion-card-content>
              <h3>{item.videoTitle}</h3>
              <p>{item.videoArtist}</p>
            </ion-card-content>
          </ion-card>
        </ion-col>
      ))}
    </ion-row>
  </ion-grid>
</div>
